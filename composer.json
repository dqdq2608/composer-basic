{
  "name": "quan/composer-basics",
  "type": "library",
  "description": "This is the composer basic library for learning purpose",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "dqdq",
      "email": "quandong2608@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "test": [
      "vendor/bin/phpunit"
    ]
  }
}
